.DS_Store

# CCTV Video, Snapshot & Evidence Storage (Preserve directory structure via .gitkeep)
storage/recordings/*
!storage/recordings/.gitkeep
storage/snapshots/*
!storage/snapshots/.gitkeep
storage/evidence/*
!storage/evidence/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/backups/*
!storage/backups/.gitkeep
storage/logs/*
!storage/logs/.gitkeep

# Local SQLite databases (metadata cache)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Large model weights (track references/manifests, not multi-gigabyte binaries)
models/**/*.onnx
models/**/*.bin
models/**/*.xml
models/**/*.pt
models/**/*.engine
!models/**/.gitkeep

# Sensitive Credentials & Certificates
storage/vault/*
!storage/vault/.gitkeep
*.pem
*.key
*.crt
*.pfx
credentials.json
